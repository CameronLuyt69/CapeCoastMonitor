# copy to .env and change the values
POSTGRES_USER=capecoast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=capecoast
GRAFANA_ADMIN_PASSWORD=change-me
SEQ_ADMIN_PASSWORD_HASH=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# optional read-only login, leave blank to disable
VIEWER_USERNAME=
VIEWER_PASSWORD=
API_PORT=8088
ALERT_WEBHOOK_URL=http://n8n:5678/webhook/capecoast-alerts
# optional: when set, alerts carry X-CCM-Signature (HMAC-SHA256 of the body)
ALERT_WEBHOOK_SECRET=
# used for the link inside alert messages
PUBLIC_URL=http://localhost:8088
