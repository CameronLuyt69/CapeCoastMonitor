{
  "uid": "ccm-beach-trends",
  "title": "Cape Coast: beach trends",
  "description": "Waves, swell, wind, sea temperature and the modelled sea level proxy for one beach, with daily min and max.",
  "tags": [
    "capecoast"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-3d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "beach",
        "label": "Beach",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "capecoast-pg"
        },
        "refresh": 1,
        "sort": 5,
        "query": "SELECT name AS __text, id AS __value FROM locations WHERE active ORDER BY name",
        "definition": "SELECT name AS __text, id AS __value FROM locations WHERE active ORDER BY name",
        "current": {},
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Alert incidents",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "capecoast-pg"
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capecoast-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT e.opened_at AS time, r.name || ' (' || r.severity || ')' AS text, 'alert' AS tags FROM alert_events e JOIN alert_rules r ON r.id = e.rule_id WHERE e.location_id = $beach AND $__timeFilter(e.opened_at)"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Wave height",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "capecoast-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capecoast-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT observed_at AS time, wave_height_m AS \"Hourly\" FROM marine_observations WHERE location_id = $beach AND source = 'open-meteo-marine' AND $__timeFilter(observed_at) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capecoast-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day AS time, wave_max AS \"Daily max\" FROM marine_daily WHERE location_id = $beach AND $__timeFilter(day) ORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capecoast-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day AS time, wave_min AS \"Daily min\" FROM marine_daily WHERE location_id = $beach AND $__timeFilter(day) ORDER BY 1"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: m",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Daily max"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.fillBelowTo",
                "value": "Daily min"
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Daily min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Hourly model values with each day's minimum and maximum shaded, so spikes are not averaged away."
