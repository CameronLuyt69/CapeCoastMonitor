          "editorMode": "code",
          "rawSql": "SELECT source AS \"Source\", count(*) AS \"Rows\", count(*) FILTER (WHERE cardinality(quality_flags) > 0) AS \"Flagged rows\", min(observed_at) AS \"From\", max(observed_at) AS \"To\" FROM (SELECT source, observed_at, quality_flags FROM marine_observations WHERE location_id = $beach AND $__timeFilter(observed_at) UNION ALL SELECT source, observed_at, quality_flags FROM wind_observations WHERE location_id = $beach AND $__timeFilter(observed_at) UNION ALL SELECT source, observed_at, quality_flags FROM weather_observations WHERE location_id = $beach AND $__timeFilter(observed_at)) x GROUP BY source ORDER BY source"
