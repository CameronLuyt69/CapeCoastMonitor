    "capecoast"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Source freshness",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "capecoast-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capecoast-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "\nWITH last AS (\n  SELECT DISTINCT ON (source) source, status, started_at, rows_written\n  FROM ingestion_runs ORDER BY source, started_at DESC),\nok AS (\n  SELECT source, max(finished_at) AS last_success FROM ingestion_runs WHERE (status = 'succeeded' OR (status = 'flagged' AND rows_written > 0)) GROUP BY source)\nSELECT l.source AS \"Source\",\n       CASE WHEN ok.last_success IS NULL OR now() - ok.last_success > 3 * (CASE WHEN l.source = 'cct-coastal-water-quality' THEN 1440 ELSE 60 END) * interval '1 minute'\n            THEN 'STALE' ELSE 'ok' END AS \"Freshness\",\n       l.status AS \"Last run\",\n       to_char(l.started_at, 'YYYY-MM-DD HH24:MI:SS') AS \"Started\",\n       to_char(ok.last_success, 'YYYY-MM-DD HH24:MI:SS') AS \"Last delivered data\",\n       round(EXTRACT(EPOCH FROM (now() - ok.last_success)) / 60) AS \"Minutes since\",\n       CASE WHEN l.source = 'cct-coastal-water-quality' THEN 1440 ELSE 60 END AS \"Expected every (min)\",\n       l.rows_written AS \"Rows changed\"\nFROM last l LEFT JOIN ok USING (source) ORDER BY l.source\n"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Source"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 215
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last run"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last delivered data"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 175
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Minutes since"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Expected every (min)"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rows changed"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 115
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Freshness"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "STALE": {
                        "color": "red",
                        "index": 0
                      },
                      "ok": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "A source is stale when it has delivered no data for three expected intervals. A flagged run that wrote rows counts as delivered; a flagged run that wrote nothing (an unreadable report) does not."
    },
    {
