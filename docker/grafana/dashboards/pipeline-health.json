          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT source AS metric, count(*) AS value FROM ingestion_runs WHERE status = 'failed' AND started_at > now() - interval '24 hours' GROUP BY source ORDER BY source"
