    {
      "id": 12,
      "type": "table",
      "title": "Open alert incidents",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "capecoast-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "capecoast-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT e.id AS \"Incident\", r.name AS \"Rule\", l.name AS \"Beach\", r.severity AS \"Severity\", e.opened_at AS \"Opened\", e.last_seen_at AS \"Last seen\", e.breach_count AS \"Breaches\", round(e.peak_value::numeric, 2) AS \"Peak\", (e.last_notified_at IS NOT NULL) AS \"Message sent\" FROM alert_events e JOIN alert_rules r ON r.id = e.rule_id JOIN locations l ON l.id = e.location_id WHERE e.resolved_at IS NULL ORDER BY e.opened_at DESC"
        }
      ],
      "gridPos": {
        "x": 0,
